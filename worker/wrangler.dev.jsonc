{
  // Local-only config: same Worker, plus a simulated KV namespace so the private
  // admin database persists between `wrangler dev` restarts (stored under .wrangler/state).
  // Production keeps using wrangler.jsonc — do not commit a real KV id here.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amqx-cityair-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "AMQX_KV", "id": "localdev0000000000000000000000000" }],
  "vars": {
    "SITE_URL": "https://aqmx.atikova.com",
    "SITE_NAME": "CityAir",
    "BOT_USERNAME": "AQMX_cityair_tracker_bot",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "HF_MODEL": "Qwen/Qwen2.5-7B-Instruct",
    "KB_VERSION": "1.0.0"
  }
}
